        <mxCell id="legendbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6d8dc;verticalAlign=top;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" value="Como leer este diagrama" vertex="1">
